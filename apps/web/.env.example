# Korean public-data-portal service key for the
# abandonmentPublicService_v2 API. Get one at https://www.data.go.kr/
# and copy this file to apps/web/.env.local (git-ignored).
#
# Server-only — no NEXT_PUBLIC_ prefix. Read by the Next Route Handler
# at apps/web/app/api/data-go-kr/[...path]/route.ts; never shipped to
# the browser bundle.
#
# In Vercel: Project (web) → Settings → Environment Variables, scope
# Production + Preview. Same value can be used for both unless you
# rotate per environment.
DATA_GO_KR_SERVICE_KEY=
